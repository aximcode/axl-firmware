Subject: [PATCH] ArmVirtPkg, OvmfPkg: drive bochs-display on AARCH64

Add QemuVideoDxe to ArmVirtQemu (DSC and FDF), so a virt machine's
bochs-display (a PCI display controller with a linear framebuffer and no
VGA) gets a GOP. Two changes make it work there:

 - PcdRemapFrameBufferWriteCombine=TRUE: the framebuffer BAR otherwise
   maps as Device memory, where unaligned pixel writes fault;
 - QemuVideoDxe skips the legacy VGA register accesses (colour mode,
   attribute unblank, DAC palette) for a device of display subclass
   "other" in the MMIO variant, on architectures other than x86. The
   MMIO variant reaches those registers in BAR2 at 0x400, where
   bochs-display has nothing: unassigned MMIO, which faults on virt.
   The standard VGA (subclass VGA) keeps them, since QEMU blanks a VGA
   display whose attribute controller was never unblanked; x86 builds
   are unchanged.

axl-firmware's patch against edk2-stable202611, applied after
0001-pointer-drivers.patch to a copy of the packages it touches.

---
diff --git a/ArmVirtPkg/ArmVirtQemu.dsc b/ArmVirtPkg/ArmVirtQemu.dsc
index 8efe121..bf27866 100644
--- a/ArmVirtPkg/ArmVirtQemu.dsc
+++ b/ArmVirtPkg/ArmVirtQemu.dsc
@@ -150,6 +150,10 @@
   #  It could be set FALSE to save size.
   gEfiMdeModulePkgTokenSpaceGuid.PcdConOutGopSupport|TRUE
 
+  ## The display's framebuffer BAR maps as Device memory on ARM, where
+  #  unaligned pixel writes fault: remap it write-combining.
+  gUefiOvmfPkgTokenSpaceGuid.PcdRemapFrameBufferWriteCombine|TRUE
+
   gEfiMdeModulePkgTokenSpaceGuid.PcdTurnOffUsbLegacySupport|TRUE
 
   gArmVirtTokenSpaceGuid.PcdTpm2SupportEnabled|$(TPM2_ENABLE)
@@ -412,6 +416,7 @@
   # Video support
   #
   OvmfPkg/QemuRamfbDxe/QemuRamfbDxe.inf
+  OvmfPkg/QemuVideoDxe/QemuVideoDxe.inf
   OvmfPkg/VirtioGpuDxe/VirtioGpu.inf
   OvmfPkg/PlatformDxe/Platform.inf
 
diff --git a/ArmVirtPkg/ArmVirtQemuFvMain.fdf.inc b/ArmVirtPkg/ArmVirtQemuFvMain.fdf.inc
index 243e931..6379116 100644
--- a/ArmVirtPkg/ArmVirtQemuFvMain.fdf.inc
+++ b/ArmVirtPkg/ArmVirtQemuFvMain.fdf.inc
@@ -189,6 +189,7 @@ READ_LOCK_STATUS   = TRUE
   # Video support
   #
   INF OvmfPkg/QemuRamfbDxe/QemuRamfbDxe.inf
+  INF OvmfPkg/QemuVideoDxe/QemuVideoDxe.inf
   INF OvmfPkg/VirtioGpuDxe/VirtioGpu.inf
   INF OvmfPkg/PlatformDxe/Platform.inf
 
diff --git a/OvmfPkg/QemuVideoDxe/Driver.c b/OvmfPkg/QemuVideoDxe/Driver.c
index 6feca83..dfe37ee 100644
--- a/OvmfPkg/QemuVideoDxe/Driver.c
+++ b/OvmfPkg/QemuVideoDxe/Driver.c
@@ -1003,12 +1003,60 @@ VgaInb (
   return Data;
 }
 
+/**
+  Whether the device's legacy VGA registers may be accessed.
+
+  The MMIO variant reaches them in BAR2 at 0x400, where the standard VGA
+  has them. bochs-display (a display controller of subclass "other") has
+  no VGA, and that part of its BAR is unassigned. x86 reads unassigned
+  MMIO as all ones and ignores writes, so nothing changes there; on other
+  architectures, such as AARCH64's virt, the accesses fault.
+
+  secondary-vga has the same IDs and subclass, so on those architectures
+  it is treated the same way.
+
+  @param[in] Private  The device.
+
+  @retval TRUE   The VGA registers may be accessed.
+  @retval FALSE  They may not.
+**/
+STATIC
+BOOLEAN
+HasLegacyVgaRegisters (
+  IN QEMU_VIDEO_PRIVATE_DATA  *Private
+  )
+{
+ #if defined (MDE_CPU_IA32) || defined (MDE_CPU_X64)
+  return TRUE;
+ #else
+  EFI_STATUS  Status;
+  UINT8       SubClass;
+
+  if (Private->Variant != QEMU_VIDEO_BOCHS_MMIO) {
+    return TRUE;
+  }
+
+  Status = Private->PciIo->Pci.Read (
+                                 Private->PciIo,
+                                 EfiPciIoWidthUint8,
+                                 PCI_CLASSCODE_OFFSET + 1,
+                                 1,
+                                 &SubClass
+                                 );
+  return EFI_ERROR (Status) || (SubClass != PCI_CLASS_DISPLAY_OTHER);
+ #endif
+}
+
 VOID
 InitializeBochsGraphicsMode (
   QEMU_VIDEO_PRIVATE_DATA  *Private,
   QEMU_VIDEO_MODE_DATA     *ModeData
   )
 {
+  BOOLEAN  VgaRegisters;
+
+  VgaRegisters = HasLegacyVgaRegisters (Private);
+
   DEBUG ((
     DEBUG_INFO,
     "InitializeBochsGraphicsMode: %dx%d @ %d\n",
@@ -1017,12 +1065,14 @@ InitializeBochsGraphicsMode (
     ModeData->ColorDepth
     ));
 
-  /* set color mode */
-  VgaOutb (Private, MISC_OUTPUT_REGISTER, 0x01);
+  if (VgaRegisters) {
+    /* set color mode */
+    VgaOutb (Private, MISC_OUTPUT_REGISTER, 0x01);
 
-  /* reset flip flop + unblank */
-  VgaInb (Private, INPUT_STATUS_1_REGISTER);
-  VgaOutb (Private, ATT_ADDRESS_REGISTER, 0x20);
+    /* reset flip flop + unblank */
+    VgaInb (Private, INPUT_STATUS_1_REGISTER);
+    VgaOutb (Private, ATT_ADDRESS_REGISTER, 0x20);
+  }
 
   BochsWrite (Private, VBE_DISPI_INDEX_ENABLE, 0);
   BochsWrite (Private, VBE_DISPI_INDEX_BANK, 0);
@@ -1041,7 +1091,10 @@ InitializeBochsGraphicsMode (
     VBE_DISPI_ENABLED | VBE_DISPI_LFB_ENABLED
     );
 
-  SetDefaultPalette (Private);
+  if (VgaRegisters) {
+    SetDefaultPalette (Private);
+  }
+
   ClearScreen (Private);
 }
 
