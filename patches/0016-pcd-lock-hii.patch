Subject: [PATCH] MdeModulePkg/PcdDxe: no allocation or free under mPcdDatabaseLock

PcdDxe held mPcdDatabaseLock while it allocated and freed memory: in
GetWorker() around GetHiiVariable() and its FreePool() (a DynamicHii
PCD whose variable exists), in SetWorker() around SetHiiVariable(), and
in DxeRegisterCallBackWorker() and DxeUnRegisterCallBackWorker() around
a callback entry's AllocatePool() and FreePool(). With the UEFI heap
guard (PcdHeapGuardPropertyMask BIT0|BIT1 and pool or page types that
include the type allocated) an allocation or free sets or clears guard
pages through the CPU arch protocol's SetMemoryAttributes(). On X64
OVMF that reaches CpuDxe's GetPageTableEntry(), which reads the dynamic
PcdPteMemoryEncryptionAddressOrMask: PcdDxe again, on the lock it
holds, and EfiAcquireLock() ASSERTs (UefiLib.c, "Lock->Lock ==
EfiLockReleased"). Seen as Tcg2ConfigDxe's InitializeTcg2VersionInfo()
reading PcdTcgPhysicalPresenceInterfaceVer with a TPM attached: the
heap-guarded DEBUG image never reached BDS.

GetWorker() and SetWorker() now release the lock around the variable
call and make the call under a lock of its own, mPcdHiiVariableLock
(TPL_NOTIFY, taken before mPcdDatabaseLock, never after), so HII
variable reads and writes stay serialized as they were. SetWorker()
holds it for the whole Set, so a pointer-type PCD's new size and its
variable are seen together, two Sets of PCDs sharing a variable cannot
interleave their read-modify-write, and no Get copies into a default
buffer while SetHiiVariable() reads the defaults for a new variable. The heap guard's re-entry gets a Data PCD and takes only
mPcdDatabaseLock. GetWorker() takes mPcdDatabaseLock again for the
pointer-type size and the copy into the default buffer, and frees the
variable's buffer after releasing both (a buffer a failed second
GetVariable() left is freed too, where it leaked). Everything read
before the release (the GUID, the name, the VARIABLE_HEAD, the default
buffer's address, the attributes and offset) points into, or comes from,
the PCD database, which never moves and whose fields no Set changes.
The variable services still run at TPL_NOTIFY, as before. The callback
register and unregister functions allocate the entry before taking the
lock, and free an unused or removed entry after releasing it; so
registering a function already registered now allocates and frees an
entry, and can fail with EFI_OUT_OF_RESOURCES where it could not.

axl-firmware's patch against edk2-stable202611, applied after
0015-reconnect-rng.patch to a copy of the packages it touches.

---
diff --git a/MdeModulePkg/Universal/PCD/Dxe/Pcd.c b/MdeModulePkg/Universal/PCD/Dxe/Pcd.c
index 0e37081..7e094bb 100644
--- a/MdeModulePkg/Universal/PCD/Dxe/Pcd.c
+++ b/MdeModulePkg/Universal/PCD/Dxe/Pcd.c
@@ -14,6 +14,11 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 /// PCD database lock.
 ///
 EFI_LOCK  mPcdDatabaseLock = EFI_INITIALIZE_LOCK_VARIABLE (TPL_NOTIFY);
+//
+// Serializes the HII variable reads and writes of Get and Set, which run
+// without mPcdDatabaseLock because they allocate (see GetWorker()).
+//
+EFI_LOCK  mPcdHiiVariableLock = EFI_INITIALIZE_LOCK_VARIABLE (TPL_NOTIFY);
 
 ///
 /// PCD_PROTOCOL the EDKII native implementation which support dynamic
@@ -1055,21 +1060,36 @@ DxeRegisterCallBackOnSet (
   IN  PCD_PROTOCOL_CALLBACK  CallBackFunction
   )
 {
-  EFI_STATUS  Status;
+  EFI_STATUS         Status;
+  CALLBACK_FN_ENTRY  *NewEntry;
 
   if (CallBackFunction == NULL) {
     return EFI_INVALID_PARAMETER;
   }
 
+  //
+  // Allocated, and freed if unused, without the lock: with the UEFI heap
+  // guard an allocation may get a dynamic PCD itself (see GetWorker()).
+  //
+  NewEntry = AllocatePool (sizeof (CALLBACK_FN_ENTRY));
+  if (NewEntry == NULL) {
+    ASSERT (NewEntry != NULL);
+    return EFI_OUT_OF_RESOURCES;
+  }
+
   //
   // Aquire lock to prevent reentrance from TPL_CALLBACK level
   //
   EfiAcquireLock (&mPcdDatabaseLock);
 
-  Status = DxeRegisterCallBackWorker (TokenNumber, Guid, CallBackFunction);
+  Status = DxeRegisterCallBackWorker (TokenNumber, Guid, CallBackFunction, &NewEntry);
 
   EfiReleaseLock (&mPcdDatabaseLock);
 
+  if (NewEntry != NULL) {
+    FreePool (NewEntry);
+  }
+
   return Status;
 }
 
@@ -1093,21 +1113,31 @@ DxeUnRegisterCallBackOnSet (
   IN  PCD_PROTOCOL_CALLBACK  CallBackFunction
   )
 {
-  EFI_STATUS  Status;
+  EFI_STATUS         Status;
+  CALLBACK_FN_ENTRY  *OldEntry;
 
   if (CallBackFunction == NULL) {
     return EFI_INVALID_PARAMETER;
   }
 
+  OldEntry = NULL;
+
   //
   // Aquire lock to prevent reentrance from TPL_CALLBACK level
   //
   EfiAcquireLock (&mPcdDatabaseLock);
 
-  Status = DxeUnRegisterCallBackWorker (TokenNumber, Guid, CallBackFunction);
+  Status = DxeUnRegisterCallBackWorker (TokenNumber, Guid, CallBackFunction, &OldEntry);
 
   EfiReleaseLock (&mPcdDatabaseLock);
 
+  //
+  // Freed without the lock, as in DxeRegisterCallBackOnSet().
+  //
+  if (OldEntry != NULL) {
+    FreePool (OldEntry);
+  }
+
   return Status;
 }
 
diff --git a/MdeModulePkg/Universal/PCD/Dxe/Service.c b/MdeModulePkg/Universal/PCD/Dxe/Service.c
index 761f422..6913368 100644
--- a/MdeModulePkg/Universal/PCD/Dxe/Service.c
+++ b/MdeModulePkg/Universal/PCD/Dxe/Service.c
@@ -389,13 +389,16 @@ GetWorker (
   UINT32         Offset;
   STRING_HEAD    StringTableIdx;
   BOOLEAN        IsPeiDb;
+  BOOLEAN        HiiLocked;
 
   //
   // Aquire lock to prevent reentrance from TPL_CALLBACK level
   //
   EfiAcquireLock (&mPcdDatabaseLock);
 
-  RetPtr = NULL;
+  RetPtr    = NULL;
+  Data      = NULL;
+  HiiLocked = FALSE;
 
   ASSERT (TokenNumber > 0);
   //
@@ -464,7 +467,24 @@ GetWorker (
         VaraiableDefaultBuffer = (UINT8 *)PcdDb + VariableHead->DefaultValueOffset;
       }
 
-      Status = GetHiiVariable (Guid, Name, &Data, &DataSize);
+      //
+      // GetHiiVariable() allocates, and FreePool() frees, memory. With the
+      // UEFI heap guard either sets guard pages through the CPU arch
+      // protocol, which may get a dynamic PCD itself (X64 CpuDxe's page
+      // table code gets a Data one): under mPcdDatabaseLock that re-entry
+      // ASSERTs. So the variable is read under mPcdHiiVariableLock alone,
+      // which keeps HII variable reads and writes serialized as before,
+      // and freed after both locks are released. Guid, Name, VariableHead
+      // and VaraiableDefaultBuffer point into the PCD database, which never
+      // moves, at data no Set changes; the pointer-type size is read under
+      // mPcdDatabaseLock again, below. The lock order is
+      // mPcdHiiVariableLock, then mPcdDatabaseLock.
+      //
+      EfiReleaseLock (&mPcdDatabaseLock);
+      EfiAcquireLock (&mPcdHiiVariableLock);
+      HiiLocked = TRUE;
+      Status    = GetHiiVariable (Guid, Name, &Data, &DataSize);
+      EfiAcquireLock (&mPcdDatabaseLock);
       if (Status == EFI_SUCCESS) {
         if (DataSize >= (VariableHead->Offset + GetSize)) {
           if (GetSize == 0) {
@@ -488,8 +508,6 @@ GetWorker (
           //
           CopyMem (VaraiableDefaultBuffer, Data + VariableHead->Offset, GetSize);
         }
-
-        FreePool (Data);
       }
 
       RetPtr = (VOID *)VaraiableDefaultBuffer;
@@ -510,6 +528,13 @@ GetWorker (
   }
 
   EfiReleaseLock (&mPcdDatabaseLock);
+  if (HiiLocked) {
+    EfiReleaseLock (&mPcdHiiVariableLock);
+  }
+
+  if (Data != NULL) {
+    FreePool (Data);
+  }
 
   return RetPtr;
 }
@@ -524,6 +549,9 @@ GetWorker (
   @param Guid               PCD token space's guid,
                             if not NULL, this PCD is dynamicEx type PCD.
   @param CallBackFunction   Callback function pointer
+  @param NewEntry           An entry the caller allocated before it took the
+                            lock: used, and set to NULL, when the function is
+                            not registered yet; else left for the caller to free.
 
   @return EFI_SUCCESS Always success for registering callback function.
 
@@ -532,7 +560,8 @@ EFI_STATUS
 DxeRegisterCallBackWorker (
   IN  UINTN                  TokenNumber,
   IN  CONST EFI_GUID         *Guid  OPTIONAL,
-  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction
+  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction,
+  IN OUT CALLBACK_FN_ENTRY   **NewEntry
   )
 {
   CALLBACK_FN_ENTRY  *FnTableEntry;
@@ -565,11 +594,11 @@ DxeRegisterCallBackWorker (
     ListNode = GetNextNode (ListHead, ListNode);
   }
 
-  FnTableEntry = AllocatePool (sizeof (CALLBACK_FN_ENTRY));
-  if (FnTableEntry == NULL) {
-    ASSERT (FnTableEntry != NULL);
-    return EFI_OUT_OF_RESOURCES;
-  }
+  //
+  // The entry was allocated by the caller, before it took the lock.
+  //
+  FnTableEntry = *NewEntry;
+  *NewEntry    = NULL;
 
   FnTableEntry->CallbackFn = CallBackFunction;
   InsertTailList (ListHead, &FnTableEntry->Node);
@@ -587,6 +616,8 @@ DxeRegisterCallBackWorker (
   @param Guid               PCD token space's guid.
                             if not NULL, this PCD is dynamicEx type PCD.
   @param CallBackFunction   Callback function pointer
+  @param OldEntry           The entry removed, for the caller to free once it
+                            has released the lock; untouched when none was.
 
   @retval EFI_SUCCESS               Callback function is success to be unregister.
   @retval EFI_INVALID_PARAMETER     Can not find the PCD entry by given token number.
@@ -595,7 +626,8 @@ EFI_STATUS
 DxeUnRegisterCallBackWorker (
   IN  UINTN                  TokenNumber,
   IN  CONST EFI_GUID         *Guid  OPTIONAL,
-  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction
+  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction,
+  OUT CALLBACK_FN_ENTRY      **OldEntry
   )
 {
   CALLBACK_FN_ENTRY  *FnTableEntry;
@@ -624,7 +656,7 @@ DxeUnRegisterCallBackWorker (
       // the Link List and return EFI_SUCCESS.
       //
       RemoveEntryList (ListNode);
-      FreePool (FnTableEntry);
+      *OldEntry = FnTableEntry;
 
       return EFI_SUCCESS;
     }
@@ -1180,8 +1212,11 @@ SetWorker (
   }
 
   //
-  // Aquire lock to prevent reentrance from TPL_CALLBACK level
+  // Aquire lock to prevent reentrance from TPL_CALLBACK level. An HII PCD's
+  // variable is written under mPcdHiiVariableLock alone (see the HII case
+  // below), which is taken first and held for the whole Set.
   //
+  EfiAcquireLock (&mPcdHiiVariableLock);
   EfiAcquireLock (&mPcdDatabaseLock);
 
   //
@@ -1242,7 +1277,17 @@ SetWorker (
       Name           = (UINT16 *)(StringTable + VariableHead->StringIndex);
       VariableOffset = VariableHead->Offset;
       Attributes     = VariableHead->Attributes;
-      Status         = SetHiiVariable (Guid, Name, Attributes, Data, *Size, VariableOffset);
+      //
+      // SetHiiVariable() allocates and frees memory: under
+      // mPcdHiiVariableLock alone, as in GetWorker(). That lock is held
+      // for the whole Set, so the size set above and the variable written
+      // here are seen together, two Sets of PCDs sharing a variable cannot
+      // interleave their read and write of it, and no Get copies into a
+      // default buffer while SetHiiVariable() reads the defaults.
+      //
+      EfiReleaseLock (&mPcdDatabaseLock);
+      Status = SetHiiVariable (Guid, Name, Attributes, Data, *Size, VariableOffset);
+      EfiAcquireLock (&mPcdDatabaseLock);
       break;
 
     case PCD_TYPE_DATA:
@@ -1290,6 +1335,7 @@ SetWorker (
   }
 
   EfiReleaseLock (&mPcdDatabaseLock);
+  EfiReleaseLock (&mPcdHiiVariableLock);
 
   return Status;
 }
diff --git a/MdeModulePkg/Universal/PCD/Dxe/Service.h b/MdeModulePkg/Universal/PCD/Dxe/Service.h
index f415504..fe76109 100644
--- a/MdeModulePkg/Universal/PCD/Dxe/Service.h
+++ b/MdeModulePkg/Universal/PCD/Dxe/Service.h
@@ -1009,6 +1009,9 @@ SetHiiVariable (
   @param Guid               PCD token space's guid,
                             if not NULL, this PCD is dynamicEx type PCD.
   @param CallBackFunction   Callback function pointer
+  @param NewEntry           An entry the caller allocated before it took the
+                            lock: used, and set to NULL, when the function is
+                            not registered yet; else left for the caller to free.
 
   @return EFI_SUCCESS Always success for registering callback function.
 
@@ -1017,7 +1020,8 @@ EFI_STATUS
 DxeRegisterCallBackWorker (
   IN  UINTN                  TokenNumber,
   IN  CONST EFI_GUID         *Guid  OPTIONAL,
-  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction
+  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction,
+  IN OUT CALLBACK_FN_ENTRY   **NewEntry
   );
 
 /**
@@ -1030,6 +1034,8 @@ DxeRegisterCallBackWorker (
   @param Guid               PCD token space's guid.
                             if not NULL, this PCD is dynamicEx type PCD.
   @param CallBackFunction   Callback function pointer
+  @param OldEntry           The entry removed, for the caller to free once it
+                            has released the lock; untouched when none was.
 
   @retval EFI_SUCCESS               Callback function is success to be unregister.
   @retval EFI_INVALID_PARAMETER     Can not find the PCD entry by given token number.
@@ -1038,7 +1044,8 @@ EFI_STATUS
 DxeUnRegisterCallBackWorker (
   IN  UINTN                  TokenNumber,
   IN  CONST EFI_GUID         *Guid  OPTIONAL,
-  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction
+  IN  PCD_PROTOCOL_CALLBACK  CallBackFunction,
+  OUT CALLBACK_FN_ENTRY      **OldEntry
   );
 
 /**
@@ -1188,3 +1195,4 @@ extern  EFI_GUID  **TmpTokenSpaceBuffer;
 extern  UINTN     TmpTokenSpaceBufferCount;
 
 extern EFI_LOCK  mPcdDatabaseLock;
+extern EFI_LOCK  mPcdHiiVariableLock;
