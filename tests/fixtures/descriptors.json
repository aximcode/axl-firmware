{
  "10-axl-firmware-edk2-stable202611-r1-x64.json": {
    "description": "axl-firmware edk2-stable202611-r1 for X64 (q35), DEBUG, edk2 edk2-stable202611",
    "interface-types": [
      "uefi"
    ],
    "mapping": {
      "device": "flash",
      "mode": "split",
      "executable": {
        "filename": "/p/edk2-stable202611-r1/x64/code.fd",
        "format": "raw"
      },
      "nvram-template": {
        "filename": "/p/edk2-stable202611-r1/x64/vars.fd",
        "format": "raw"
      }
    },
    "targets": [
      {
        "architecture": "x86_64",
        "machines": [
          "pc-q35-*"
        ]
      }
    ],
    "features": [
      "acpi-s3",
      "amd-sev",
      "amd-sev-es",
      "verbose-dynamic"
    ],
    "tags": [
      "edk2-stable202611",
      "556dcfb466e9f05affeaff881d738807f8156d3c",
      "edk2-stable202611-r1",
      "DEBUG"
